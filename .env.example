# Copy to .env and fill in. .env is git-ignored.

# --- Provider: "anthropic" (default) or "openai" (any OpenAI-compatible endpoint) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Model id. Defaults: claude-sonnet-5-5 (anthropic) / gpt-4o-mini (openai).
# Cheaper/faster option for this use case: claude-haiku-5-5
# LLM_MODEL=claude-sonnet-5-5

# --- OpenAI-compatible endpoints (only when LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1   # e.g. Ollama (any non-empty OPENAI_API_KEY works)

# --- Optional ---
# LLM_TEMPERATURE=0.3        # set to empty to omit the parameter
# LLM_MAX_TOKENS=1024
# STORE_NOW=2026-02-20T10:00 # pin "now" (store time, America/Campo_Grande) for reproducible demos
